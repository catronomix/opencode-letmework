{
  "name": "@catronomix/opencode-letmework",
  "version": "0.2.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "OpenCode plugin that auto-approves permission prompts for the project's sibling work folder after a short, interruptible delay.",
  "type": "module",
  "license": "MIT",
  "author": "Innocent Coppieters",
  "homepage": "https://github.com/catronomix/opencode-letmework",
  "bugs": {
    "url": "https://github.com/catronomix/opencode-letmework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catronomix/opencode-letmework.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "permissions",
    "worktree"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node scripts/release-check.mjs",
    "release-check": "node scripts/release-check.mjs",
    "test": "node --test logic.test.ts plugin.test.ts define.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.2",
    "@types/node": "^22.10.2",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2"
  }
}
